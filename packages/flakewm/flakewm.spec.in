# Generated from upstream-lock.json; see PATCHES.md for source patch history.
@COMMITS@
Name:           flakewm
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        GXDE Wayland compositor
License:        GPL-3.0-or-later
URL:            https://github.com/GXDE-OS/flake-wm
@SOURCES@
Source100:      build.sh
Source101:      sources.sha256
Source102:      upstream-lock.json
Source103:      split-files.py
ExclusiveArch:  x86_64 aarch64

BuildRequires:  gcc gcc-c++ cmake ninja-build meson
BuildRequires:  glslang-devel hwdata-devel
BuildRequires:  wayland-protocols-devel vulkan-headers
BuildRequires:  systemd-devel
BuildRequires:  qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qt5compat-devel

BuildRequires:  pkgconfig(cairo) pkgconfig(glib-2.0) pkgconfig(json-c)
BuildRequires:  pkgconfig(libdisplay-info) pkgconfig(libdrm)
BuildRequires:  libepoxy-devel libglvnd-devel
BuildRequires:  pkgconfig(libinput) pkgconfig(libjpeg)
BuildRequires:  pkgconfig(libliftoff) pkgconfig(libpng)
BuildRequires:  pkgconfig(librsvg-2.0) pkgconfig(libunwind)
BuildRequires:  pkgconfig(xcb) pkgconfig(xkbcommon)
BuildRequires:  mesa-libGL-devel mesa-libgbm-devel lcms2-devel
BuildRequires:  pkgconfig(openssl) pkgconfig(pango) pkgconfig(pixman-1)
BuildRequires:  pkgconfig(libseat) pkgconfig(libsystemd)
BuildRequires:  pkgconfig(vulkan)
BuildRequires:  pkgconfig(wayland-client) pkgconfig(wayland-server)
BuildRequires:  xcb-util-errors-devel xcb-util-renderutil-devel xcb-util-wm-devel
BuildRequires:  xorg-x11-server-Xwayland-devel

# Runtime deps are auto-generated by RPM from ELF NEEDED entries.
# Only list deps that rpm auto-detection cannot find:
Requires:       xorg-x11-server-Xwayland

%description
FlakeWM is the GXDE Wayland compositor, a wlroots-based compositor
maintained by the GXDE OS project. It provides the Wayland session
for the GXDE desktop environment.

%prep
(cd %{_sourcedir} && sha256sum -c %{SOURCE101})
%setup -q -c -T -a 0
mv flake-wm-%{commit0} flakewm
cp %{SOURCE102} upstream-lock.json

%build
%set_build_flags
bash %{SOURCE100} "%{_libdir}" "%{_smp_build_ncpus}"

%install
cp -a stage/. %{buildroot}/
find %{buildroot} -type f -name '*.la' -delete
python3 %{SOURCE103} %{buildroot}

%check
test -x %{buildroot}%{_bindir}/flakewm
test -x %{buildroot}%{_bindir}/startflakewm

%files -f runtime.files
%license flakewm/LICENSE
%doc upstream-lock.json

%changelog
* Mon Oct 19 2026 CharOfString <root@charofstring.cc> - @VERSION@-@RELEASE@
- Package flakewm from pinned upstream release for Fedora 44 and 45
